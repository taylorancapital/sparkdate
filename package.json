{
  "name": "sparkdate",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "brief": "node scripts/session-brief.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=verbose",
    "social:lint": "node scripts/lint-content-queue.js",
    "social:import": "python scripts/import-worksheet.py",
    "social:preflight": "node scripts/social-preflight.js",
    "ga4:fetch": "node scripts/fetch-ga4-tables.js",
    "ads:check": "node scripts/check-meta-ad-tags.js",
    "ads:traffic": "node scripts/meta-restore-traffic.js",
    "ads:lint": "node scripts/lint-ad-copy.js",
    "ads:utm-sync": "python scripts/sync-utm-content.py",
    "ads:creative": "node scripts/meta-set-ad-creative.js",
    "ads:plan": "node scripts/build-paid-campaign.js",
    "ads:handoff": "node scripts/build-paid-campaign.js --handoff",
    "ads:review": "node scripts/meta-ads-review.js",
    "ads:pixel": "node scripts/meta-attach-pixel.js",
    "ads:goal": "node scripts/meta-set-adset-goal.js",
    "ads:pause-stale": "node scripts/meta-pause-stale.js",
    "ads:lx-sales": "node scripts/meta-create-lx-sales-campaign.js",
    "ads:lx-switch": "node scripts/meta-lx-switch-to-sales.js",
    "ads:mc-sales": "node scripts/meta-create-mc-sales-campaign.js",
    "ads:ladder": "node scripts/meta-budget-ladder.js",
    "social:plan": "node scripts/social.js plan",
    "social:approve": "node scripts/social.js approve",
    "social:run": "node scripts/social.js run",
    "social:prep": "python scripts/prep-social-assets.py",
    "social:crop": "python scripts/crop-photo.py",
    "listing:pack": "node scripts/build-listing-pack.js --out=build/listing-pack.md",
    "listing:json": "node scripts/build-listing-pack.js --json",
    "email:check": "node scripts/check-email-dns.js",
    "social:handoff": "node scripts/design-handoff.js",
    "social:design-setup": "node scripts/design-project-setup.js",
    "social:export": "node scripts/build-campaign-export.js",
    "social:video": "python scripts/build-tiktok-video.py",
    "social:build": "node scripts/build-calendar.js --out=build/SparkDate_30DAY_CALENDAR.md && node scripts/design-handoff.js --events=MC,TL,GG,LX --out=build/SparkDate_DESIGN_BRIEF.md && node scripts/build-campaign-export.js --all --outdir=build/campaign-sheets",
    "gender:backfill": "node scripts/backfill-gender.js",
    "listing:redirects": "node scripts/build-listing-redirects.js --write",
    "listing:check": "node scripts/build-listing-redirects.js --check"
  },
  "dependencies": {
    "firebase": "^10.7.0",
    "firebase-admin": "^12.0.0",
    "resend": "^3.0.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
