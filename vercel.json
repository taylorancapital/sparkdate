{
  "crons": [
    {
      "path": "/api/cron-send-emails",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron-send-emails",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/founding",
      "destination": "/founding.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/event",
      "destination": "/event.html"
    },
    {
      "source": "/event/:id",
      "destination": "/event.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
