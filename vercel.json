{
  "functions": {
    "api/next-event.js": {
      "includeFiles": "public/event.html"
    },
    "api/lead-signup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-send-emails",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron-send-emails",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron-send-emails?only=postevent",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-send-emails?only=postevent",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://www.googletagmanager.com https://www.gstatic.com https://cdn.formspree.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.stripe.com https://m.stripe.network wss://*.firebaseio.com https://www.googletagmanager.com; frame-src https://js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|jpg|jpeg|webp|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sparkdate.date" }],
      "destination": "https://sparkdate.date/:path*",
      "permanent": true
    },
    {
      "source": "/flyer",
      "destination": "/lp?utm_source=flyer&utm_medium=offline&utm_campaign=week1_math",
      "permanent": false
    },
    {
      "source": "/flyer/",
      "destination": "/lp?utm_source=flyer&utm_medium=offline&utm_campaign=week1_math",
      "permanent": false
    },
    {
      "source": "/card",
      "destination": "/lp?utm_source=qr&utm_medium=offline&utm_campaign=business_card",
      "permanent": false
    },
    {
      "source": "/founding",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/event",
      "destination": "/api/next-event?render=page"
    },
    {
      "source": "/event/:id",
      "destination": "/api/next-event?render=page&id=:id"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/lp",
      "destination": "/lp.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin.html"
    },
    {
      "source": "/matches",
      "destination": "/matches.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/conversation-starters",
      "destination": "/blog/conversation-starters.html"
    },
    {
      "source": "/blog/what-to-wear",
      "destination": "/blog/what-to-wear.html"
    },
    {
      "source": "/blog/first-timer-guide",
      "destination": "/blog/first-timer-guide.html"
    },
    {
      "source": "/blog/first-timer-guide-lancaster",
      "destination": "/blog/first-timer-guide-lancaster.html"
    },
    {
      "source": "/blog/philly-date-night-spots",
      "destination": "/blog/philly-date-night-spots.html"
    },
    {
      "source": "/blog/how-same-night-matching-works",
      "destination": "/blog/how-same-night-matching-works.html"
    },
    {
      "source": "/blog/dating-app-burnout",
      "destination": "/blog/dating-app-burnout.html"
    },
    {
      "source": "/blog/signs-your-first-date-is-going-well",
      "destination": "/blog/signs-your-first-date-is-going-well.html"
    },
    {
      "source": "/blog/lancaster-date-night-spots",
      "destination": "/blog/lancaster-date-night-spots.html"
    },
    {
      "source": "/blog/how-to-ask-for-a-second-date",
      "destination": "/blog/how-to-ask-for-a-second-date.html"
    },
    {
      "source": "/philadelphia",
      "destination": "/api/next-event?render=city&city=philadelphia"
    },
    {
      "source": "/lancaster",
      "destination": "/api/next-event?render=city&city=lancaster"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/next-event?render=sitemap"
    }
  ]
}
